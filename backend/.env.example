# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/writegen_ai

# ── Auth (REQUIRED in production — use a long random string) ─────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── Groq (free alternative to OpenAI — https://console.groq.com) ────────────
GROQ_API_KEY=<your_groq_api_key>
OPENAI_MODEL=llama-3.3-70b-versatile

# ── AI Behaviour ──────────────────────────────────────────────────────────────
USE_MOCK_AI=true
USE_FALLBACK_ONLY=false
AI_TIMEOUT_MS=5000
AI_MAX_RETRIES=2

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_FALLBACK=true
ENABLE_AB_TESTING=true
ENABLE_CACHING=true

# ── Credits ───────────────────────────────────────────────────────────────────
FREE_DAILY_CREDITS=10
PREMIUM_DAILY_CREDITS=100

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GENERATE=5
RATE_LIMIT_AUTH=20

# ── Performance ───────────────────────────────────────────────────────────────
SLOW_THRESHOLD_MS=3000
CACHE_MAX_ENTRIES=200

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
