{
  "name": "@writegen/writegen-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WriteGen AI - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testEnvironment node --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:security": "jest --testEnvironment node --forceExit --detectOpenHandles --testPathPatterns=security",
    "test:unit": "jest --testEnvironment node --forceExit --detectOpenHandles --testPathPatterns=unit",
    "audit:check": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.1.0",
    "joi": "^17.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "openai": "^4.20.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "stripe": "^14.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "lodash": "4.18.0",
    "express-validator": {
      "lodash": "4.18.0"
    }
  }
}
